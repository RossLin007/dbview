# 数据库连接
DATABASE_URL=postgresql://admin:cHczwTs7JeYfeMpH@42.192.204.232:35432/postgres

# 大语言模型 (LLM / OpenAI 兼容接口) 配置
# 如果您使用的是 DeepSeek、硅基流动 (SiliconFlow)、通义千问 (DashScope)、Moonshot 或 OpenAI 代理，请在此配置 API Key 和 Base URL。
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 本地账号 JWT 认证配置
# AUTH_JWT_SECRET 必须为随机字符串（>=16 位），生成命令: openssl rand -hex 32
AUTH_JWT_SECRET=please-run-openssl-rand-hex-32
# Token 有效期（小时），默认 168 = 7 天
AUTH_TOKEN_TTL_HOURS=168

# 允许访问的用户白名单 (用英文逗号分隔)，白名单内邮箱可自助注册
ALLOWED_EMAILS=user1@example.com,user2@example.com

# 服务对外暴露端口配置 (按需自定义，对称优雅)
BACKEND_PORT=3301
FRONTEND_PORT=7880





